#!/usr/bin/env python3
"""
Add a new find to content/finds/finds.csv.
Usage: ./find "Title" "URL"
       ./find "Title" "URL" "archive_url"   # provide archive URL manually
"""

import json
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

import yt_dlp

FINDS_CSV   = Path("content/finds/finds.csv")
ARCHIVE_DIR = Path("content/finds/archive")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> None:
    if len(sys.argv) < 3:
        sys.exit("Usage: find <title> <url> [archive_url]")

    title, url = sys.argv[1], sys.argv[2]
    manual_archive = sys.argv[3] if len(sys.argv) > 3 else None

    if ";" in title or ";" in url:
        sys.exit("Error: title or URL contains a semicolon")
    if title == url:
        sys.exit("Error: title and URL are the same")

    bundle_dir = None

    if manual_archive:
        archive_url = manual_archive
    elif re.search(r"youtube\.com/watch|youtu\.be/", url):
        archive_url, bundle_dir = archive_youtube(url)
    elif "podcasts.apple.com" in url:
        archive_url, bundle_dir = archive_podcast(url)
    else:
        archive_url = archive_web(url)

    with open(FINDS_CSV, "a") as f:
        f.write(f"{title};{url};{archive_url}\n")

    paths = [FINDS_CSV] + ([bundle_dir] if bundle_dir else [])
    git_commit(title, paths)


# ---------------------------------------------------------------------------
# Archive handlers
# ---------------------------------------------------------------------------

def archive_youtube(url: str) -> tuple[str, Path]:
    info, bundle_dir = _download(url, {
        "format":              "bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio/best",
        "merge_output_format": "mp4",
        "writethumbnail":      True,
        "writesubtitles":      True,
        "writeautomaticsub":   False,
        "subtitleslangs":      ["en"],
        "getcomments":         True,
        "extractor_args":      {"youtube": {"comment_sort": ["top"], "max_comments": ["300"]}},
        "postprocessors": [
            {"key": "FFmpegThumbnailsConvertor", "format": "jpg", "when": "before_dl"},
        ],
    })

    # Fall back to auto-generated subs if no manual ones were downloaded
    if not list(bundle_dir.glob("*.vtt")):
        print("No manual subtitles found, falling back to auto-generated...")
        with yt_dlp.YoutubeDL({
            "outtmpl":           str(bundle_dir / "%(id)s.%(ext)s"),
            "writeautomaticsub": True,
            "subtitleslangs":    ["en"],
            "skip_download":     True,
        }) as ydl:
            ydl.download([url])

    generate_page(info, bundle_dir, "video")
    return f"/finds/archive/{info['id'].lower()}/", bundle_dir


def archive_podcast(url: str) -> tuple[str, Path]:
    info, bundle_dir = _download(url, {
        "writethumbnail": True,
        "postprocessors": [
            {"key": "FFmpegThumbnailsConvertor", "format": "jpg", "when": "before_dl"},
        ],
    })

    generate_page(info, bundle_dir, "podcast")
    return f"/finds/archive/{info['id'].lower()}/", bundle_dir


def archive_web(url: str) -> str:
    import waybackpy
    ua = "Mozilla/5.0"
    try:
        return waybackpy.WaybackMachineAvailabilityAPI(url, ua).newest().archive_url
    except Exception:
        print("No existing archive found, saving now...")
        try:
            return waybackpy.WaybackMachineSaveAPI(url, ua).save()
        except Exception as e:
            print(f"Warning: could not archive {url}: {e}", file=sys.stderr)
            return url


def _download(url: str, extra_opts: dict) -> tuple[dict, Path]:
    """Download media and return (info dict, bundle dir).

    yt-dlp returns all metadata — title, description, comments, etc. — directly
    in the info dict, so nothing sensitive is written to disk.
    """
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)

    opts = {
        "outtmpl": str(ARCHIVE_DIR / "%(id)s" / "%(id)s.%(ext)s"),
        **extra_opts,
    }

    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=True)
    except yt_dlp.utils.DownloadError as e:
        sys.exit(f"Download failed: {e}")

    return info, ARCHIVE_DIR / info["id"]


# ---------------------------------------------------------------------------
# Hugo page bundle generation
# ---------------------------------------------------------------------------

def generate_page(info: dict, bundle_dir: Path, media_type: str) -> None:
    media_id     = info["id"]
    title        = info.get("title") + " [archive]" or "Unknown"
    uploader     = info.get("uploader") or info.get("channel") or ""
    channel_url  = info.get("channel_url") or ""
    original_url = info.get("webpage_url") or ""
    description  = info.get("description") or ""
    comments     = info.get("comments") or []

    upload_date = info.get("upload_date") or ""
    if upload_date:
        upload_date = f"{upload_date[:4]}-{upload_date[4:6]}-{upload_date[6:8]}"

    duration = ""
    if d := info.get("duration"):
        h, rem = divmod(int(d), 3600)
        m, s   = divmod(rem, 60)
        duration = f"{h:02d}:{m:02d}:{s:02d}"

    media_file = next(
        (f"{media_id}.{ext}"
         for ext in ("mp4", "mkv", "webm", "mp3", "m4a", "ogg", "opus")
         if (bundle_dir / f"{media_id}.{ext}").exists()),
        None,
    )
    thumbnail = next(
        (f"{media_id}.{ext}"
         for ext in ("jpg", "png", "webp")
         if (bundle_dir / f"{media_id}.{ext}").exists()),
        None,
    )

    index_adoc = bundle_dir / "index.adoc"
    with open(index_adoc, "w") as f:

        # Frontmatter — json.dumps produces valid YAML double-quoted strings and
        # handles all escaping (backslashes, quotes, control characters, etc.)
        f.write("---\n")
        f.write(f"title: {json.dumps(title)}\n")
        f.write('layout: "archive"\n')
        f.write(f'media_type: "{media_type}"\n')
        if upload_date:
            f.write(f'date: "{upload_date}"\n')
        f.write(f'archived: "{date.today()}"\n')
        if uploader:
            f.write(f"uploader: {json.dumps(uploader)}\n")
        if channel_url:
            f.write(f'channel_url: "{channel_url}"\n')
        f.write(f'media_id: " {media_id}"\n')
        if original_url:
            f.write(f'original_url: "{original_url}"\n')
        if media_file:
            f.write(f'media_file: "{media_file}"\n')
        if thumbnail:
            f.write(f'thumbnail: "{thumbnail}"\n')
        if duration:
            f.write(f'duration: "{duration}"\n')
        if vc := info.get("view_count"):
            f.write(f"view_count: {vc}\n")
        if lc := info.get("like_count"):
            f.write(f"like_count: {lc}\n")
        f.write("---\n")

        if description:
            # Prevent Hugo from interpreting {{ }} as shortcodes
            safe = description.replace("{{", "{{`").replace("}}", "`}}")
            f.write(f"\n== Description\n\n{safe.strip()}\n")

        if comments:
            f.write("\n== Comments\n\n")
            _write_comment_tree(f, comments)

    print(f"Hugo page generated: {index_adoc}")


def _write_comment_tree(f, comments: list) -> None:
    by_parent: dict[str, list] = {}
    for c in comments:
        by_parent.setdefault(c.get("parent") or "root", []).append(c)

    def header(c: dict) -> str:
        s = f"**{c.get('author', 'Anonymous')}**"
        if lc := c.get("like_count", 0):
            s += f" · {lc} likes"
        return s

    def render(parent_id: str, prefix: str = "") -> None:
        children = by_parent.get(parent_id, [])
        for i, c in enumerate(children):
            last = i == len(children) - 1
            arm  = "└── " if last else "├── "
            cont = "    " if last else "│   "
            text = (c.get("text") or "").strip().replace("\n", " ")
            f.write(f"{prefix}{arm}{header(c)}: [.comment]#{text.strip()}#\n")
            if cid := c.get("id"):
                render(cid, prefix + cont)

    for root in by_parent.get("root", []):
        f.write(f"{header(root)}: ")
        f.write(f"[.comment]#{(root.get("text") or "").strip()}#\n")
        if root.get("id") in by_parent:
            render(root["id"])
        f.write("\n\n")
        
    if (len(comments) == 300):
        f.write("pass:[[comments truncated]]")


# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

def git_commit(title: str, paths: list[Path]) -> None:
    str_paths = [str(p) for p in paths]
    subprocess.run(["git", "add", "--", *str_paths], check=True)
    subprocess.run(["git", "commit", "-m", f"new find: {title}", "--", *str_paths], check=True)


if __name__ == "__main__":
    main()
